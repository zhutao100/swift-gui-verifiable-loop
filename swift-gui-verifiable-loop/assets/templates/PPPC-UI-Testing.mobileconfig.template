<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template only. Do not install verbatim.

  Replace all ${...} placeholders with organization-specific values generated by
  your MDM/PPPC tooling. Confirm the responsible executable with:

    scripts/macos/tcc_attribution_tail.sh --duration 45 --out .artifacts/tcc.log
    scripts/macos/collect_tcc_identities.sh /path/to/responsible.app-or-binary

  Typical candidates are the Xcode UI testing helper/runner, Xcode, Terminal,
  the agent CLI, or a stable wrapper app/binary used to invoke xcodebuild.
-->
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key>
      <string>com.apple.TCC.configuration-profile-policy</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadIdentifier</key>
      <string>${ORG_ID}.pppc.swift-ui-testing</string>
      <key>PayloadUUID</key>
      <string>${PAYLOAD_UUID}</string>
      <key>PayloadDisplayName</key>
      <string>Swift UI Testing PPPC</string>
      <key>Services</key>
      <dict>
        <key>Accessibility</key>
        <array>
          <dict>
            <key>IdentifierType</key>
            <string>${IDENTIFIER_TYPE}</string>
            <key>Identifier</key>
            <string>${IDENTIFIER}</string>
            <key>CodeRequirement</key>
            <string>${CODE_REQUIREMENT}</string>
            <key>Allowed</key>
            <true/>
            <key>Comment</key>
            <string>Allow UI-test automation to inspect and control the app under test.</string>
          </dict>
        </array>
        <key>PostEvent</key>
        <array>
          <dict>
            <key>IdentifierType</key>
            <string>${IDENTIFIER_TYPE}</string>
            <key>Identifier</key>
            <string>${IDENTIFIER}</string>
            <key>CodeRequirement</key>
            <string>${CODE_REQUIREMENT}</string>
            <key>Allowed</key>
            <true/>
            <key>Comment</key>
            <string>Allow the UI-test automation process to synthesize input events.</string>
          </dict>
        </array>
      </dict>
    </dict>
  </array>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
  <key>PayloadIdentifier</key>
  <string>${ORG_ID}.swift-ui-testing</string>
  <key>PayloadUUID</key>
  <string>${PROFILE_UUID}</string>
  <key>PayloadDisplayName</key>
  <string>Swift UI Testing Privacy Preferences</string>
  <key>PayloadDescription</key>
  <string>Pre-approves privacy classes needed by managed macOS UI-test hosts.</string>
  <key>PayloadOrganization</key>
  <string>${ORG_NAME}</string>
</dict>
</plist>
